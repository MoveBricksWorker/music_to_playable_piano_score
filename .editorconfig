# ---------------------------------------------------------------------------
# .editorconfig — 让不同编辑器对这套代码的默认行为一致
#
# 本项目所有源码与文档都是 UTF-8。Windows 上的编辑器默认可能是 GBK，
# 把中文注释写成乱码（产物 JSON 里出现过：`杩欎簺 tick 涓婄殑...`）。
# 这里显式声明；配合 .gitattributes 一起用。
# ---------------------------------------------------------------------------

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{bat,cmd}]
# Windows 批处理：必须 CRLF，而且要保持**纯 ASCII**
# （cmd.exe 用 OEM 代码页解码 .bat，UTF-8 的中文注释会被当命令执行）
end_of_line = crlf
charset = ascii
insert_final_newline = false

[*.{musicxml,xml}]
indent_size = 2
